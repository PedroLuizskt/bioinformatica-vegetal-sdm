# Modelo do .env (este arquivo PODE ser versionado; o .env real NAO).
# O 02_setup_python.ps1 gera o .env com os caminhos absolutos da sua maquina.

# NCBI Entrez: email obrigatorio; chave de API opcional (3 -> 10 requisicoes/s)
NCBI_EMAIL=seu.email@exemplo.com
NCBI_API_KEY=

# Caminhos do workspace (barra normal)
BIOINFO_RAIZ=C:/Users/pedro/Downloads/bioinformatic
BIOINFO_DADOS=C:/Users/pedro/Downloads/bioinformatic/03_dados
BIOINFO_TMP=C:/Users/pedro/Downloads/bioinformatic/05_scratch/tmp_py

# Teto de threads para BLAS/OpenMP
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_MAX_THREADS=4

# Cache do GDAL em MB
GDAL_CACHEMAX=512
